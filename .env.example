# PostgreSQL
# Host port published by Docker; PostgreSQL remains on 5432 inside Compose.
POSTGRES_EXTERNAL_PORT=5433
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=mamba
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mambamomentum

# Backend / JWT
SECRET_KEY=change-this-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend
VITE_API_BASE_URL=/api/v1
